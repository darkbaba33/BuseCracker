<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUSE CRACKER"
        android:textColor="#00FFCC"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:shadowColor="#00FFCC"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> Ultimate Analysis Engine v5.0"
        android:textColor="#666666"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_select_file"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="[ HEDEF DOSYAYI SEC ]"
        android:textColor="#000000"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:backgroundTint="#00FFCC"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> Sistem Hazir. Bekleniyor..."
        android:textColor="#FFCC00"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:layout_marginBottom="10dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#00FFCC"
        android:visibility="invisible"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F0F0F"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> Cikti bekleniyor..."
            android:textColor="#A0A0A0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>
</LinearLayout>
