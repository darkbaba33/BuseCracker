<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUSE CRACKER"
        android:textColor="#00FFCC"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:shadowColor="#00FFCC"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> Lib / APK Analiz Motoru v2.1"
        android:textColor="#888888"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_select_file"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SISTEME DOSYA YUKLE"
        android:textColor="#000000"
        android:textStyle="bold"
        android:backgroundTint="#00FFCC"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> Durum: Sistem Hazir. Dosya Bekleniyor..."
        android:textColor="#FFCC00"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:layout_marginBottom="10dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminateTint="#00FFCC"
        android:visibility="invisible"
        android:layout_marginBottom="10dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> Analiz sonuclari burada gorunecek..."
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

</LinearLayout>
