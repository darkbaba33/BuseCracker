<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06080A"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUSE CRACKER"
        android:textColor="#00FFCC"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:shadowColor="#00FFCC"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="15"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> Gelismis Lib / APK Analiz Motoru v3.0"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_select_file"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SISTEME DOSYA YUKLE"
        android:textColor="#000000"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:backgroundTint="#00FFCC"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> Durum: Bekleniyor..."
        android:textColor="#FFCC00"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:layout_marginBottom="10dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#00FFCC"
        android:visibility="invisible"
        android:layout_marginBottom="15dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F1115"
        android:padding="12dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="> Analiz bekleniyor...\n> Lutfen bir .so veya .apk dosyasi secin."
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"/>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
